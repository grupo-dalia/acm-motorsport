# ─────────────────────────────────────────────────────────────
# ACM MOTORSPORT — variables de entorno
# Copia este archivo a .env.local. NUNCA subas .env.local al repo.
# Sin ninguna variable, la web arranca en MODO DEMO.
# ─────────────────────────────────────────────────────────────

# URL pública (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vídeo del hero (MP4/WebM, idealmente <8 MB, 1080p, sin audio). Vacío = placeholder.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_POSTER_URL=

# Google Analytics 4 — solo se carga tras consentimiento de cookies analíticas
NEXT_PUBLIC_GA_ID=

# Modo del comercio: demo | sandbox | live
#  demo    → catálogo y checkout simulados, no se contacta con nadie
#  sandbox → Stripe test + Printful sin confirmar pedidos (Fase 4)
#  live    → cobros reales. Requiere además ALLOW_LIVE_ORDERS=true
COMMERCE_MODE=demo
ALLOW_LIVE_ORDERS=false

# Stripe (Fase 4) — solo servidor
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Printful (Fase 4) — solo servidor
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=

# Supabase (Fase 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email transaccional (Fase 3/4) — p.ej. Resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="ACM Motorsport <hola@acmmotorsport.com>"
